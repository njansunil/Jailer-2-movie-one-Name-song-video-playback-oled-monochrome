int decode85(uint8_t*o){uint32_t a=0;int n=0,k=0;for(const char*p=Z;*p;p++){if(*p=='z'){o[k++]=0;o[k++]=0;o[k++]=0;o[k++]=0;continue;}a=a*85+v85(*p);if(++n==5){o[k++]=a>>24;o[k++]=a>>16;o[k++]=a>>8;o[k++]=a;a=0;n=0;}}return k;}
